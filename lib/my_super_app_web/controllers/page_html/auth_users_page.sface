<Search
    id="default-search"
    {=@filter}
    on_keyup="change_filter"
    options={[]}
    class="pb-4"
    prompt="Search by login"
    >
<Dropdown id="default-dropdown" disabled>
    <Dropdown.Trigger disabled />
</Dropdown>
</Search>

<Dropdown id="page-size-dropdown">
<Dropdown.Options titles={[5, 10]} on_change="on_change_page_size"/>
<Dropdown.Trigger>
    <Chip>Choose page size</Chip>
</Dropdown.Trigger>
</Dropdown>

<Table
    items={user <- users_page(assigns)}
    {=@sort}
    sorting_click="on_sorting_click"
    {=@selected}
    >
    <Column name="login" label="Login" sortable>
        {user.login}
    </Column>
    <Column label="Email">
        {user.email}
    </Column>
    <Column name="updated_at" label="Updated at" sortable>
        {user.updated_at |> DateTime.to_date} {user.updated_at |> NaiveDateTime.to_time}
    </Column>
</Table>

<Pagination id="with_buttons" total_pages={ceil(length(@users) / @page_size) |> max(1)} value={@current_page} on_change="set_current_page">
    <Pagination.PrevButton>
        <ControlsChevronLeftSmall class="text-moon-24 rtl:rotate-180" />
    </Pagination.PrevButton>
    <Pagination.Pages />
    <Pagination.NextButton>
        <ControlsChevronRightSmall class="text-moon-24 rtl:rotate-180" />
    </Pagination.NextButton>
</Pagination>