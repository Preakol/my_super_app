<div class="mx-auto max-w-2xl py-10">
    <h1 class="text-moon-32 font-medium transition-colors mb-10">Welcome to Admin Part "{@current_user.login}"</h1>
    <div class="flex flex-col gap-4">
        <Button as="a"
                href="/admin/users"
                right_icon="generic-star"
                left_icon="generic-star"
                class="bg-bulma text-goku w-full flex justify-between"
        >
        Users
        </Button>
        <Button as="a"
                href="/admin/posts"
                right_icon="generic-news"
                left_icon="generic-news"
                class="bg-bulma text-goku w-full flex justify-between"
        >
        Posts
        </Button>
        <Button as="a"
                href="/admin/pictures"
                right_icon="generic-picture"
                left_icon="generic-picture"
                class="bg-bulma text-goku w-full flex justify-between"
        >
        Pictures
        </Button>
        <Button as="a"
            href="/admin/operators"
            right_icon="generic-loyalty"
            left_icon="generic-loyalty"
            class="bg-bulma text-goku w-full flex justify-between"
            :if={@current_user.permissions == 1}
        >
        Operators
        </Button>
        <Button as="a"
            href="/admin/site-configs"
            right_icon="generic-lightning-bolt"
            left_icon="generic-lightning-bolt"
            class="bg-bulma text-goku w-full flex justify-between"
            :if={@current_user.permissions < 3}
        >
        Site Configs
        </Button>
        <Button as="a"
            href="/admin/roles"
            right_icon="generic-heart"
            left_icon="generic-heart"
            class="bg-bulma text-goku w-full flex justify-between"
            :if={@current_user.permissions < 3}
        >
        Roles
        </Button>
    </div>
</div>