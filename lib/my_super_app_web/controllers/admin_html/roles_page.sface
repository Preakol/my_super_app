<h1 class="text-moon-32 font-medium transition-colors">Roles</h1>
<div class="flex flex-row border-b-[0.063rem] border-beerus pt-5 pb-4 relative gap-3">
  <Dropdown id="filter-operator-dropdown">
    <Dropdown.Options
      class="w-auto"
      titles={["All"] ++ (@operators_to_choose |> Enum.map(& &1.key))}
      on_change="change_operator_filter"
    />
    <Dropdown.Trigger :let={is_open: is_open}>
      <Button variant="outline" class="bg-gohan text-zeno">
        {@filters.operator}
        <Moon.Icons.ControlsChevronDown class={"text-trunks text-moon-16 transition-transform transition-200", "rotate-180": is_open} />
      </Button>
    </Dropdown.Trigger>
  </Dropdown>
  <Button on_click="toggle_create_modal" values={action: "open"}
    class="border border-bulma bg-bulma text-goku hover:text-bulma hover:bg-goku"
  >Add New Role</Button>
</div>
<div class="flex flex-row justify-between border-b-[0.063rem] border-beerus pt-5 pb-4 relative">
  <Dropdown id="page-size-dropdown">
    <Dropdown.Options titles={[5, 10]} on_change="on_change_page_size" class="p-0" />
    <Dropdown.Trigger>
      <Chip class="border border-bulma w-50 hover:text-goku hover:bg-bulma">Page size: {@page_size}</Chip>
    </Dropdown.Trigger>
  </Dropdown>
  <Pagination
    id="default"
    total_pages={ceil(length(@roles) / @page_size) |> max(1)}
    value={@current_page}
    on_change="set_current_page"
    class="w-50"
  >
    <Pagination.PrevButton variant="ghost">
      <ControlsChevronLeft class="text-moon-24" />
    </Pagination.PrevButton>
    <Pagination.Pages class="hidden" />
    <Pagination.NextButton variant="ghost">
      <ControlsChevronRight class="text-moon-24" />
    </Pagination.NextButton>
  </Pagination>
</div>
<Table
  sort={@filters.sorting}
  items={role <- PageHelper.select_content_for_page(assigns, @roles)}
  sorting_click="handle_sorting_click"
  row_bg="bg-heles"
  header_row_class="bg-goku"
  row_gap="border-spacing-y-0"
  sorting_icon="arrows_up"
  class="rounded-0"
>
  <Column name="id" label="#" sortable class="first:rounded-0">
    {role.id}
  </Column>
  <Column name="name" label="Name" sortable>
    {role.name}
  </Column>
  <Column name="operator" label="Operator">
    {role.operator_name}
  </Column>
  <Column name="updated_at" label="Last Update" sortable>
    {role.updated_at |> Timex.shift(hours: 3) |> Timex.format!("%b %d, %Y, %H:%M:%S", :strftime)}
  </Column>
  <Column class="last:rounded-0">
    {#if role.permissions != 2}
      <IconButton icon="files_generic" variant="ghost" on_click="drawer_update_open" value={role.id} />
    {/if}
  </Column>
</Table>
<Drawer id="drawer_update" is_open={@drawer_update_open} on_close="do_nothing">
  <Drawer.Panel>
    <div class="border-b-[0.063rem] border-beerus pt-5 pb-4 px-6 relative">
      <h3 class="text-moon-18 text-bulma font-medium">Update Role</h3>
      <IconButton
        icon="controls_close"
        variant="ghost"
        on_click="drawer_close"
        class="absolute top-3 right-5"
      />
    </div>
    <div class="px-6 py-4">
      <Form for={@form_update} change="validate_update" submit="update" class="flex flex-col gap-3">
        <Field field={:name} label="Name">
          <Input placeholder="Role Name" />
        </Field>
        <Field field={:permissions} label="Permission">
          <Form.Dropdown
            id="permissions-update"
            options={[
              %{key: "Viewer", value: 4, icon: "other_agent"},
              %{key: "Gamechanger", value: 3, icon: "other_player"}
            ]}
          >
            <:option :let={option: option}>
              <Moon.Icon :if={option} name={option[:icon]} />
              {option[:key] || "Please select permission"}
            </:option>
          </Form.Dropdown>
        </Field>
        <div class="flex gap-2 p-4 justify-end pt-2">
          <Button variant="outline"
            on_click="drawer_close"
            left_icon="controls_close_small"
            class="hover:text-goku hover:bg-bulma"
          >Close details</Button>
          <Button
            disabled={!@form_update.source.valid? or @form_update.source.changes == %{}}
            type="submit"
            left_icon="generic_edit"
            class={"border border-bulma bg-bulma text-goku",
                    "hover:text-bulma hover:bg-goku": @form_update.source.valid? and @form_update.source.changes != %{}
                  }
          >Update</Button>
          <Button on_click="toggle_del_modal"
            left_icon="generic_delete"
            class="border border-bulma bg-bulma text-goku hover:text-bulma hover:bg-goku"
          >Delete</Button>
        </div>
      </Form>
    </div>
  </Drawer.Panel>
</Drawer>
<Modal id="modal_create" is_open={@create_modal_open} on_close="do_nothing">
  <Modal.Backdrop />
  <Modal.Panel class="w-full max-w-lg rounded-moon-s-xs">
    <div class="border-b-[0.063rem] border-beerus pt-5 pb-4 px-6 relative">
      <h3 class="text-moon-18 text-bulma font-medium">
        Create New role
      </h3>
      <IconButton
        icon="controls_close"
        variant="ghost"
        values={action: "close"}
        on_click="toggle_create_modal"
        class="absolute top-3 right-3"
      />
    </div>
    <div class="px-6 py-4">
      <Form
        for={@form_create}
        change="validate_create"
        class="flex flex-col gap-3"
        submit="create_role"
      >
        <Field field={:operator_id} label="Operator">
          <Form.Dropdown
            id="operator-id-create"
            disabled={@current_user.permissions > 1}
            options={@operators_to_choose}
            prompt="Please select Operator"
          />
        </Field>
        <Field field={:name} label="Name">
          <Input disabled={is_nil(@form_create.params["operator_id"])} placeholder="Role Name" />
        </Field>
        <Field field={:permissions} label="Permission">
          <Form.Dropdown
            id="permissions-create"
            disabled={is_nil(@form_create.params["operator_id"])}
            options={[
              %{key: "Viewer", value: 4, icon: "other_agent"},
              %{key: "Gamechanger", value: 3, icon: "other_player"}
            ]}
          >
            <:option :let={option: option}>
              <Moon.Icon :if={option} name={option[:icon]} />
              {option[:key] || "Please select permission"}
            </:option>
          </Form.Dropdown>
        </Field>
        <div class="flex gap-2 p-4 justify-end pt-2">
          <Button variant="outline"
            on_click="toggle_create_modal"
            values={action: "close"}
            left_icon="controls_close"
            class="hover:text-goku hover:bg-bulma"
          >Cancel</Button>
          <Button
            disabled={!@form_create.source.valid?}
            type="submit"
            left_icon="controls_plus"
            class={"border border-bulma bg-bulma text-goku",
                    "hover:text-bulma hover:bg-goku": @form_create.source.valid?
                  }
          >Create</Button>
        </div>
      </Form>
    </div>
  </Modal.Panel>
</Modal>
<MyDeleteModal id="modal_delete" is_open={@del_modal_open} on_toggle="toggle_del_modal" on_delete="delete" />
