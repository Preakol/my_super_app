<h1 class="text-moon-32 font-medium transition-colors">Operators</h1>
<div class="flex flex-row border-b-[0.063rem] border-beerus pt-5 pb-4 relative gap-3">
  <Button on_click="toggle_create_modal" 
    class="border border-bulma bg-bulma text-goku hover:text-bulma hover:bg-goku"
  >Add New Operator</Button>
</div>
<div class="flex flex-row justify-between border-b-[0.063rem] border-beerus pt-5 pb-4 relative">
    <Dropdown id="page-size-dropdown">
        <Dropdown.Options titles={[5, 10]} on_change="on_change_page_size" class="p-0" />
        <Dropdown.Trigger>
            <Chip class="border border-bulma w-50 hover:text-goku hover:bg-bulma">Page size: {@page_size}</Chip>
        </Dropdown.Trigger>
    </Dropdown>
    <Pagination
        id="default"
        total_pages={ceil(length(@operators) / @page_size) |> max(1)}
        value={@current_page}
        on_change="set_current_page"
        class="w-50"
        >
        <Pagination.PrevButton variant="ghost">
            <ControlsChevronLeft class="text-moon-24" />
        </Pagination.PrevButton>
        <Pagination.Pages class="hidden" />
        <Pagination.NextButton variant="ghost">
            <ControlsChevronRight class="text-moon-24" />
        </Pagination.NextButton>
    </Pagination>
</div>
<Table
  {=@sort}
  items={operator <- PageHelper.select_content_for_page(assigns, @operators)}
  sorting_click="handle_sorting_click"
  row_bg="bg-heles"
  header_row_class="bg-goku"
  row_gap="border-spacing-y-0"
  sorting_icon="arrows_up"
  class="rounded-0"
>
  <Column name="id" label="#" sortable class="first:rounded-0">
    {operator.id}
  </Column>
  <Column name="name" label="Name" sortable>
    {operator.name}
  </Column>
  <Column name="inserted_at" label="Created At" sortable>
    {operator.inserted_at |> Timex.shift(hours: 3) |> Timex.format!("%b %d, %Y, %H:%M:%S", :strftime)}
  </Column>
  <Column class="flex flex-row justify-end last:rounded-0">
    <IconButton icon="generic_delete" on_click="toggle_del_modal" values={action: "open"} value={operator.id} variant="ghost" />
  </Column>
</Table>
<Modal id="modal_create" is_open={@create_modal_open} on_close="do_nothing">
  <Modal.Backdrop />
  <Modal.Panel class="w-full max-w-lg rounded-moon-s-xs">
    <div class="border-b-[0.063rem] border-beerus pt-5 pb-4 px-6 relative">
      <h3 class="text-moon-18 text-bulma font-medium">
        Create New Operator
      </h3>
      <IconButton
        icon="controls_close"
        variant="ghost"
        on_click="toggle_create_modal"
        class="absolute top-3 right-3"
      />
    </div>
    <div class="px-6 py-4">
      <Form for={@form_create} change="validate" submit="create">
        <Field field={:name} label="Name">
          <Input placeholder="Operator Name" />
        </Field>
        <Field field={:user_id} label="User">
          <Form.Dropdown
            id="user-id-create"
            options={@users_to_choose}
            disabled={!@form_create.params["name"]}
            prompt="Please select User for strongest role"
          />
        </Field>
        <div class="flex gap-2 p-4 justify-end pt-2">
          <Button variant="outline"
            on_click="toggle_create_modal"
            left_icon="controls_close"
            class="hover:text-goku hover:bg-bulma"
          >Cancel</Button>
          <Button
            disabled={!@form_create.params["user_id"]}
            type="submit"
            left_icon="controls_plus"
            class={"border border-bulma bg-bulma text-goku",
                      "hover:text-bulma hover:bg-goku": @form_create.params["user_id"]
                    }
          >Create</Button>
        </div>
      </Form>
    </div>
  </Modal.Panel>
</Modal>
<MyDeleteModal id="modal_delete" 
  is_open={@del_modal_open}
  on_toggle="toggle_del_modal"
  on_delete="delete"
  header={"Delete Operator #{@operator_to_delete.name}?"}
/>