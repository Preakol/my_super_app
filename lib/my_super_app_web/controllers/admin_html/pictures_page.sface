<div class="flex flex-row border-b-[0.063rem] border-beerus pt-5 pb-5 relative gap-3">
    <h1 class="text-moon-32 font-medium transition-colors">Pictures</h1>
</div>
<div class="flex flex-row pt-5 gap-3">
  <Button on_click="modal_add_open"
    class="border border-bulma bg-bulma text-goku hover:text-bulma hover:bg-goku"
  >
    Add New Picture
  </Button>
  <Input on_keyup="change_search" placeholder="Search by post id or title, picture filename, and post author name or email" value={@filters.search} class="max-w-2xl focus:shadow-input-cell-focus" />
</div>
<div class="flex flex-row border-b-[0.063rem] border-beerus pt-5 pb-5 relative gap-3">
  <div class="flex">
    <Dropdown id="sorting_dropdown" on_change="change_sort_param">
      <Dropdown.Options titles={@sorting_options} class="p-0 z-10" />
      <Dropdown.Trigger>
        <Chip class="border border-bulma rounded-none sm:rounded-l-xl w-48 whitespace-nowrap text-pretty hover:text-goku hover:bg-bulma">
          {@filters.sorting |> Enum.at(0) |> elem(1)}
        </Chip>
      </Dropdown.Trigger>
      <Dropdown.Backdrop />
    </Dropdown>
    <Chip on_click="change_sort_dir" class="border border-bulma rounded-none sm:rounded-r-xl hover:text-goku hover:bg-bulma">
      <ArrowsUp class={"text-moon-24 transition-transform transition-200", "rotate-180": @filters.sorting |> Enum.at(0) |> elem(0) == :desc} />
    </Chip>
  </div>
  <div class="flex">
    <Dropdown id="tags_dropdown" on_change="change_tag_filter" is_open={@tag_dropdown_open} on_trigger="on_trigger_tag_filter">
      <Dropdown.Trigger>
        <Chip class="border border-bulma rounded-none sm:rounded-l-xl w-52 whitespace-nowrap text-pretty hover:text-goku hover:bg-bulma">
          Select Tags
        </Chip>
      </Dropdown.Trigger>
      <Dropdown.Options class="p-0 z-10 h-48">
        <Dropdown.Header class="whitespace-nowrap">
          Choose tags to filter:
        </Dropdown.Header>
        {#for tag <- @tags_to_choose}
          <Dropdown.CustomOption id={tag} value={tag} class="flex justify-between flex-row-reverse">
            {tag}
            <GenericCheckAlternative class="text-roshi text-moon-24" :if={tag in @filters.tags} />
          </Dropdown.CustomOption>
        {/for}
      </Dropdown.Options>
    </Dropdown>
    <Chip on_click="clear_tag_filter" class="border border-bulma rounded-none sm:rounded-r-xl hover:text-goku hover:bg-bulma">
      <MailFilterCrossed class="text-moon-24" />
    </Chip>
  </div>
  <Dropdown id="extensioin_dropdown" on_change="change_extension_filter">
    <MyDropdownOptions titles={@extension_options} class="p-0 z-10" />
    <Dropdown.Trigger>
      <Chip class="border border-bulma w-48 hover:text-goku hover:bg-bulma">
        {@extension_options |> Enum.find_value(fn %{key: k, value: v} -> if v == @filters.extension, do: k end)}
      </Chip>
    </Dropdown.Trigger>
    <Dropdown.Backdrop />
  </Dropdown>
  <Button on_click="clear_filters"
    class="border border-bulma bg-bulma text-goku hover:text-bulma hover:bg-goku"
  >
    Clear Filters
  </Button>
</div>
<div class="grid gap-4 pt-8" style="grid-template-columns: repeat(5, 1fr);">
    {#for picture <- @pictures}
      <Button on_click="drawer_update_open" value={picture.id} class="flex items-start w-[200px] h-auto flex-col justify-between gap-1 bg-krillin-10 py-4 px-0 rounded-xl shadow-moon-xl">
        <div class="flex flex-col px-2 gap-1 items-start">
          <h2 class="text-moon-20 text-bulma font-medium transition-colors">
            Post info:
          </h2>
          <span class="text-trunks text-moon-12 transition-colors">
            Post id: {picture.post && picture.post.id || "Not Assigned"}
          </span>
          <span class="text-trunks text-moon-12 transition-colors">
            Title: {picture.post && picture.post.title || "Not Assigned"}
          </span>
          <span class="text-trunks text-moon-12 transition-colors">
            Author Name: {picture.post && picture.post.user.login || "Not Assigned"}
          </span>
          <span class="text-trunks text-moon-12 transition-colors">
            Author Email: {picture.post && picture.post.user.email || "Not Assigned"}
          </span>
        </div>
        <div class="w-full h-48 overflow-hidden flex bg-krillin-60 items-center justify-center">
            <img src={picture.path} class="max-h-full max-w-full">
        </div>
        <div class="flex flex-col items-start px-2">
          <span class="text-trunks text-moon-9-caption transition-colors">
            Filename: {picture.file_name}
          </span>
          <span class="text-trunks text-moon-9-caption transition-colors">
            Upload at: {picture.upload_at |> Timex.shift(hours: 3) |> Timex.format!("%b %d, %Y, %H:%M:%S", :strftime)}
          </span>
        </div>
      </Button>
    {/for}
</div>
<Modal id="modal_add" is_open={@modal_add_open} on_close="do_nothing">
  <Modal.Backdrop />
  <Modal.Panel class="w-1/4 max-w-full rounded-moon-s-xs">
    <div class="border-b-[0.063rem] border-beerus pt-5 pb-4 px-6 relative">
      <h3 class="text-moon-18 text-bulma font-medium">
        Add picture to the post
      </h3>
      <IconButton
        icon="controls_close"
        variant="ghost"
        on_click="modal_add_close"
        class="absolute top-3 right-3 hover:text-goku hover:bg-bulma"
      />
    </div>
    <div class="px-6 py-4">
      <Form for={@form} change="validate" submit="add_picture" class="flex flex-col gap-3">
        <Field field={:post_id} label="Select Post:">
          <MyFormDropdown id="post-id-dropdown" options={@posts_to_choose}>
            <:option :let={option: option}>
              {option[:key]}{option[:picture] && "(#{option[:picture]})" || ""}
            </:option>
          </MyFormDropdown>
        </Field>
        {#if Enum.at(@uploads.new_picture.entries, 0)}
            <.live_img_preview entry={@uploads.new_picture.entries |> Enum.at(0)} class="w-full" />
        {/if}
        <Field field={:picture}>
          <div class="relative">
            <.live_file_input upload={@uploads.new_picture} class="opacity-0 absolute top-0 right-0 h-full w-full z-30 cursor-pointer" />
            <Button
              class="bg-bulma text-goku cursor-pointer w-full"
            >
              Choose file...
            </Button>
          </div>
        </Field>
        <Progress 
          value={Enum.at(@uploads.new_picture.entries, 0) |> Map.get(:progress)}
          progress_color="bg-roshi"
          :if={Enum.at(@uploads.new_picture.entries, 0) && Enum.at(@uploads.new_picture.entries, 0) |> Map.get(:preflighted?)}
        />
        <Button type="submit"
            disabled={Enum.at(@uploads.new_picture.entries, 0) |> is_nil() || Enum.at(@uploads.new_picture.entries, 0) && Enum.at(@uploads.new_picture.entries, 0) |> Map.get(:preflighted?)}
            variant="outline"
            class="bg-gohan text-zeno"
        >
          Upload Picture
        </Button>
      </Form>
    </div>
  </Modal.Panel>
</Modal>
<Drawer id="drawer_update" is_open={@drawer_update_open} on_close="do_nothing">
  <Drawer.Backdrop />
  <Drawer.Panel>
    <div class="border-b-[0.063rem] border-beerus pt-5 pb-4 px-6 relative">
      <h3 class="text-moon-18 text-bulma font-medium">
        {@form_update.data.post && "Update picture for post \"#{@form_update.data.post |> Map.get(:title)}\"" || "Assign Picture To The Post"}
      </h3>
      <IconButton
        icon="controls_close"
        variant="ghost"
        on_click="drawer_update_close"
        class="absolute top-3 right-3 hover:text-goku hover:bg-bulma"
      />
    </div>
    <div class="px-6 py-4">
      <Form for={@form_update} change="validate_update" submit="update_picture" class="flex flex-col items-center gap-3">
        {#if Enum.at(@uploads.update_picture.entries, 0)}
          <.live_img_preview entry={@uploads.update_picture.entries |> Enum.at(0)} width="70%" />
        {#else}
          <img src={@form_update.data |> Map.get(:path)} width="70%">
        {/if}
        <Field field={:picture} :if={!is_nil(@form_update.data.post)} class="w-full">
          <div class="relative">
            <.live_file_input upload={@uploads.update_picture} class="opacity-0 absolute top-0 right-0 h-full w-full z-30 cursor-pointer" />
            <Button
              class="bg-bulma text-goku cursor-pointer w-full"
            >
              Select new image...
            </Button>
          </div>
        </Field>
        <Progress 
          value={Enum.at(@uploads.update_picture.entries, 0) |> Map.get(:progress)}
          progress_color="bg-roshi"
          :if={Enum.at(@uploads.update_picture.entries, 0) && Enum.at(@uploads.update_picture.entries, 0) |> Map.get(:preflighted?)}
        />
        <Field field={:post_id} label="Post Title:" :if={is_nil(@form_update.data.post)} class="w-full">
          <MyFormDropdown id="post-id-dropdown-update" options={@posts_to_choose}>
            <:option :let={option: option}>
              {option[:key] || "Please Select Post"}{option[:picture] && "(#{option[:picture]})" || ""}
            </:option>
          </MyFormDropdown>
        </Field>
        <div class="flex flex-row gap-2 justify-end w-full pt-2">
          <Button variant="outline"
            on_click="drawer_update_close"
            class="hover:text-goku hover:bg-bulma"
          >
            Cancel
          </Button>
          <Button
            on_click="unassign_picture"
            class="border border-bulma bg-bulma text-goku hover:text-bulma hover:bg-goku"
            :if={@form_update.data.post}
          >
            Unassign
          </Button>
          <Button type="submit"
            disabled={Enum.at(@uploads.update_picture.entries, 0) |> is_nil() || Enum.at(@uploads.update_picture.entries, 0) && Enum.at(@uploads.update_picture.entries, 0) |> Map.get(:preflighted?)}
            variant="outline"
            class="bg-gohan text-zeno"
            :if={@form_update.data.post}
          >
            Update
          </Button>
          <Button type="submit"
            disabled={(@form_update.params |> Map.get("post_id")) in ["", nil]}
            variant="outline"
            class="bg-gohan text-zeno"
            :if={!@form_update.data.post}
          >
            Assign Picture
          </Button>
          <Button on_click="modal_delete_open"
            disabled={@current_user.permissions != 1 && (@form_update.data.post && @form_update.data.post |> Map.get(:user_id) != @current_user.id)}
            value={@form_update.data.id}
            class="border border-bulma bg-bulma text-goku hover:text-bulma hover:bg-goku"
          >
            Delete
          </Button>
        </div>
      </Form>
    </div>
  </Drawer.Panel>
</Drawer>
<MyDeleteModal id="modal_delete" 
  is_open={@modal_delete_open}
  on_toggle="modal_delete_close"
  on_delete="delete"
  header={"Delete picture #{Map.get(@picture_to_delete, :file_name)}?"}
/>
