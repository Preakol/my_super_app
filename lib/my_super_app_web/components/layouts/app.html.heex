<header class="border-b border-zinc-200 bg-white">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-3 sm:px-6">
    <.link navigate={~p"/"} class="flex items-center gap-2 font-semibold text-zinc-900">
      <.icon name="hero-pencil-square" class="h-5 w-5" /> MySuperApp
    </.link>
    <.user_menu current_user={assigns[:current_user]} />
  </div>
</header>
<main class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
  <.flash_group flash={@flash} />
  <%= @inner_content %>
</main>
