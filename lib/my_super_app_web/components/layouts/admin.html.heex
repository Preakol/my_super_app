<header class="border-b border-zinc-200 bg-white">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-4 py-3 sm:px-6">
    <.link navigate={~p"/admin"} class="flex items-center gap-2 font-semibold text-zinc-900">
      <.icon name="hero-squares-2x2" class="h-5 w-5" /> MySuperApp Admin
    </.link>
    <.user_menu current_user={@current_user} />
  </div>
</header>
<div class="mx-auto flex max-w-7xl gap-8 px-4 py-8 sm:px-6">
  <nav :if={@page_title != "Admin Welcome"} aria-label="Admin sections" class="w-44 shrink-0">
    <ul class="flex flex-col gap-1">
      <li :for={section <- admin_sections(@current_user)}>
        <.link
          navigate={section.path}
          class="flex items-center gap-2 rounded-md px-3 py-2 text-sm text-zinc-700 hover:bg-zinc-100 hover:text-zinc-900"
        >
          <.icon name={section.icon} class="h-4 w-4" /> <%= section.label %>
        </.link>
      </li>
    </ul>
  </nav>
  <main class="min-w-0 flex-1">
    <.flash_group flash={@flash} />
    <%= @inner_content %>
  </main>
</div>
