<header class="fixed top-0 pl-4 sm:pl-6 lg:pl-8 mb-4 bg-goku w-full z-50">
    <div class="flex items-center justify-between border-b border-zinc-100 py-3 text-sm">
        <div class="flex items-center gap-4">
            <a href="/" aria-label="main page">
                <svg class="moon-logo" style="height: 2em; width: 2em">
                    <use href=".././moon_icons/svgs/currencies/icon-bitcoin.svg#item" />
                </svg>
            </a>
        </div>
        <ul class="z-10 flex items-center gap-4 px-4 sm:px-6 lg:px-8 justify-end">
            {#if @current_user}
                <li>
                    <Moon.Design.Dropdown
                        id="avatar-dropdown"
                    >
                        <Moon.Design.Dropdown.Trigger>
                            <Moon.Design.Tooltip>
                                <Moon.Design.Tooltip.Trigger>
                                    <Moon.Components.Chip>
                                        {#if @current_user.avatar_image}
                                            <Moon.Design.Avatar image_url={@current_user.avatar_image}/>
                                        {#else}
                                            <Moon.Design.Avatar/>
                                        {/if}
                                    </Moon.Components.Chip>
                                </Moon.Design.Tooltip.Trigger>
                                <Moon.Design.Tooltip.Content position="left" has_no_shadow>
                                    {@current_user.login}<span :if={@current_user.operator_name}>({@current_user.operator_name})</span>
                                </Moon.Design.Tooltip.Content>
                            </Moon.Design.Tooltip>
                        </Moon.Design.Dropdown.Trigger>
                        <Moon.Design.Dropdown.Options position="bottom-end">
                            <Moon.Design.Dropdown.Header class="whitespace-nowrap">
                                {@current_user.login}<span :if={@current_user.operator_name}>({@current_user.operator_name})</span>
                            </Moon.Design.Dropdown.Header>
                            <a href="/users/settings" aria-label="settings page">
                                <Moon.Design.Dropdown.CustomOption>
                                    Settings
                                </Moon.Design.Dropdown.CustomOption>
                            </a>
                            <.link href={~p"/users/log_out"} class="p-4 gap-3 rounded-none border-b border-beerus hover:bg-heles" method="delete">
                                Log out
                            </.link>
                        </Moon.Design.Dropdown.Options>
                    </Moon.Design.Dropdown>
                </li>
            {#else}
                <li>
                    <a
                    href={~p"/users/register"}
                    class="text-[0.8125rem] leading-6 text-zinc-900 font-semibold hover:text-zinc-700"
                    >
                    Register
                    </a>
                </li>
                <li>
                    <.link
                    href={~p"/users/log_in"}
                    class="text-[0.8125rem] leading-6 text-zinc-900 font-semibold hover:text-zinc-700"
                    >
                    Log in
                    </.link>
                </li>
            {/if}
        </ul>
    </div>
</header>
<main class="px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl">
    <.flash_group flash={@flash} />
    {@inner_content}
  </div>
</main>